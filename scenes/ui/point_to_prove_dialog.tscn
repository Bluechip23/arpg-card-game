text = "Point to Prove: Sacrifice 5 HP to ignore Stun?"
horizontal_alignment = 1

[node name="Buttons" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2
alignment = 1

[node name="YesButton" type="Button" parent="Panel/VBox/Buttons"]
