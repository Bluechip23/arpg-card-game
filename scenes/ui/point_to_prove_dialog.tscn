[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/point_to_prove_dialog.gd" id="1_ptp"]

[node name="PointToProveDialog" type="CanvasLayer"]
script = ExtResource("1_ptp")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 0
offset_right = 350.0
offset_bottom = 80.0

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2

[node name="Label" type="Label" parent="Panel/VBox"]
