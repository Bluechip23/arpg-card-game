[resource]
script = ExtResource("1_card")
card_id = "summon_battle_turtle"
card_name = "Summon Battle Turtle"
description = "Summon a Battle Turtle (25 HP) with unerring armor equal to half your INT. Every 5 tempo it regains a fifth of that armor, up to its unerring armor. Whenever it gains armor, so do its allies. Moves 1 space every tempo."
card_type = 1
card_type_name = "Defense"
mana_cost = 65
tempo_cost = 3
target_types = ["point"]
school = 1
keywords = ["spell", "defense"]
