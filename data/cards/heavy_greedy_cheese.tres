[gd_resource type="Resource" script_class="Card" format=3]

[ext_resource type="Script" path="res://scripts/cards/card.gd" id="1_card"]

[resource]
script = ExtResource("1_card")
card_id = "heavy_greedy_cheese"
card_name = "Heavy Greedy Cheese"
description = "While in your hand, every other card in your hand costs +100 mana and +2 tempo."
card_type = 2
card_type_name = "Status"
mana_cost = 100
tempo_cost = 5
target_types = ["self"]
hover_note = "Your deck makes one whenever it reshuffles a discard pile of fewer than 3 cards — a sign it is too thin. Other Heavy Greedy Cheese in your hand count too. Play it (25% of your max mana, 5 tempo) to be rid of it for good."
erase_on_play = true
