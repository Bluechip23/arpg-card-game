[resource]
script = ExtResource("1_card")
card_id = "ember_heart"
card_name = "Ember Heart"
description = "Maintain: each cycle, 2 stacks of the Burn on you are transferred to a random enemy within 4 squares. Each stack deals 3 damage as it transfers."
